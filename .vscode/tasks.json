{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug (All)",
            "type": "shell",
            "command": "cmake --build --preset debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "Build Release (All)",
            "type": "shell",
            "command": "cmake --build --preset release",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "Build Engine Only (Debug)",
            "type": "shell",
            "command": "cmake --build --preset debug --target AIEngine",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Engine Only (Release)",
            "type": "shell",
            "command": "cmake --build --preset release --target AIEngine",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build TestGame Only (Debug)",
            "type": "shell",
            "command": "cmake --build --preset debug --target testgame",
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build TestGame Only (Release)",
            "type": "shell",
            "command": "cmake --build --preset release --target testgame",
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run TestGame",
            "type": "shell",
            "command": "cmake --build --preset debug --target run",
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        },
        {
            "label": "Clean All",
            "type": "shell",
            "command": "cmake --build --preset debug --target clean; cmake --build --preset release --target clean",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}